{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Hermes Documentation",
  "colors": {
    "primary": "#387961",
    "light": "#BEFF00",
    "dark": "#387961"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Hermes",
          "icon": "arrow-up-right",
          "hidden": true,
          "href": "https://hermesvoice.com"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://hermesvoice.com/blog"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "setup/permissions"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/dictation",
              "features/hotkeys",
              "features/ai-formatting",
              "features/hermes-reply",
              "features/hermes-edit",
              "features/notes"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "customization/formatting-modes",
              "customization/dictionary"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "settings/overview",
              "settings/dictation",
              "settings/ai-formatting",
              "settings/interface",
              "settings/privacy"
            ]
          },
          {
            "group": "Triggers",
            "pages": [
              "triggers/overview",
              "triggers/creating-triggers",
              "triggers/matching-modes",
              {
                "group": "Trigger Types",
                "pages": [
                  "triggers/types/snippets",
                  "triggers/types/web-search",
                  "triggers/types/app-launcher",
                  "triggers/types/window-layout",
                  "triggers/types/keyboard-shortcuts",
                  "triggers/types/terminal",
                  "triggers/types/apple-shortcuts",
                  "triggers/types/ai-calls",
                  "triggers/types/text-formatting"
                ]
              },
              "triggers/variables",
              "triggers/defaults"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/plans",
              "account/billing"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/common-issues",
              "troubleshooting/permissions",
              "troubleshooting/audio"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://hermesvoice.com/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://hermesvoice.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hermesvoice",
      "linkedin": "https://linkedin.com/company/relativeindustries",
      "instagram": "https://instagram.com/hermesvoice_"
    }
  },
  "description": "Learn how to get the most out of Hermes",
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "DM Sans",
    "source": "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap",
    "heading": {
      "source": "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap",
      "family": "DM Sans",
      "format": "woff2"
    },
    "body": {
      "family": "DM Sans",
      "source": "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap",
      "format": "woff2"
    },
    "format": "woff2"
  },
  "appearance": {
    "default": "light"
  }
}
